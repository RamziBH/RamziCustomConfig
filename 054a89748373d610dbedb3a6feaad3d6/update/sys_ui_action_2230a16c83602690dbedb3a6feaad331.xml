        <script><![CDATA[function pending() {

    var flag = false;

    if (g_form.getValue('resolution_note') == '') {
        g_form.setMandatory('resolution_note', true);
        flag = true;
    }

    if (g_form.getValue('close_code') == '') {
        g_form.setMandatory('close_code', true);
        flag = true;
    }
    if (flag) {

        g_form.addErrorMessage("You need to populate the 'Resolution' and 'Close Code' fields before moving to the 'Complete' state.");
        return false; //Abort submission
    }
    gsftSubmit(null, g_form.getFormElement(), 'cotl_complete');
}

if (typeof window == 'undefined')
updateTask();


function updateTask() {
    current.u_stage = "complete";
    current.state = "3";
	current.update();
    action.setRedirectURL(current);
}]]></script>
