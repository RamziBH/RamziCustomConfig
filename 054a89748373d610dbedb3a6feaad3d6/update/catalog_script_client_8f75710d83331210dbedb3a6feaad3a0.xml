        <script><![CDATA[function onChange(control, oldValue, newValue, isLoading) {
    if (isLoading || newValue == '') {
        return;
    }

    var now48 = new Date();
    now48.setHours(now48.getHours() + 48);
    //alert(now);
    var desireddate = new Date(getDateFromFormat(g_form.getValue("select_the_desired_date"), g_user_date_time_format));
    //alert(desireddate);
    if (now48 > desireddate) {
        g_form.addErrorMessage("La date de réservation désirée sera toujours 48 heures après la date actuelle.");
        g_form.clearValue('select_the_desired_date');
    }

    if (newValue != oldValue && g_form.getValue('return_date')) {
        g_form.clearValue('return_date');


    }
}]]></script>
