        <script><![CDATA[function onSubmit() {
    var attachments = this.document.getElementsByClassName('get-attachment');

    if (!attachments || attachments.length != 1) {
        getMessage('Only ONE file is allowed for this request.', function(msg) {
            alert(msg);
        });
        return false;
    }
    var details = attachments[0].text;
    var fileSize = details.lastIndexOf('(');
    var fileName = details.substring(0, fileSize - 1);
    var fileExt = fileName.substring(fileName.lastIndexOf('.'));
    if (fileExt.toLowerCase() != '.xlsx') {
        getMessage('Invalid file type. Only Excel (xlsx) is allowed.', function(msgT) {
            alert(msgT);
        });
        return false;
    }
}]]></script>
