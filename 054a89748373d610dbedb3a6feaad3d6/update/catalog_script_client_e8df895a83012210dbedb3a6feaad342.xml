        <script><![CDATA[function onLoad() {
    g_form.clearOptions('groupes_ad_gensys');
    //g_form.addOption('groupes_ad_gensys', '', getMessage('-- Choose a value --'));
    var ga = new GlideAjax('OperationalRequestHelper');
    ga.addParam('sysparm_name', 'getAdGroupeChoices');
    ga.getXMLAnswer(updatechoice);

    function updatechoice(answer) {
		alert(answer);
        if (answer) {
            var epicData = JSON.parse(answer);
            for (var i = 0; i < epicData.length; i++) {
                g_form.addOption('groupes_ad_gensys', epicData[i].sys_id, epicData[i].summary);
            }
        }
    }

}]]></script>
